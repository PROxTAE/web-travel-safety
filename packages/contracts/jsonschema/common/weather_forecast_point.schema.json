{
  "$defs": {
    "DataConflict": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "values": {
          "items": {},
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field_path",
        "values",
        "source_ids"
      ],
      "title": "DataConflict",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/DataConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "freshness_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Seconds"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "score": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/DataStatus",
          "default": "FRESH"
        },
        "weights_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Weights Version",
          "type": "string"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "DataStatus": {
      "enum": [
        "FRESH",
        "STALE",
        "UNAVAILABLE",
        "CONFLICTING",
        "PARTIAL"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "QualityFlag": {
      "enum": [
        "MISSING",
        "STALE",
        "CONFLICTING",
        "INFERRED",
        "INCOMPLETE",
        "OUTSIDE_COVERAGE"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "INFO",
        "MINOR",
        "MODERATE",
        "SEVERE",
        "EXTREME",
        "UNKNOWN"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceAuthority": {
      "enum": [
        "OFFICIAL",
        "INTERGOVERNMENTAL",
        "LICENSED_PROVIDER",
        "COMMUNITY",
        "UNKNOWN"
      ],
      "title": "SourceAuthority",
      "type": "string"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "authority": {
          "$ref": "#/$defs/SourceAuthority",
          "default": "UNKNOWN"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Record Id"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "source_id",
        "provider",
        "fetched_at",
        "content_hash"
      ],
      "title": "SourceProvenance",
      "type": "object"
    }
  },
  "$id": "https://smart-travel-assistant.local/schemas/1.0.0/WeatherForecastPoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apparent_temperature_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Apparent Temperature C"
    },
    "eta_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eta At"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "is_current": {
      "default": false,
      "title": "Is Current",
      "type": "boolean"
    },
    "location": {
      "$ref": "#/$defs/Point"
    },
    "precipitation_mm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Precipitation Mm"
    },
    "precipitation_probability": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Precipitation Probability"
    },
    "probe": {
      "default": "PLANNED",
      "description": "DELAYED = same point sampled at ETA + delay probe",
      "enum": [
        "PLANNED",
        "DELAYED"
      ],
      "title": "Probe",
      "type": "string"
    },
    "probe_delay_minutes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Delay Minutes"
    },
    "quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "route_sample_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Sample Index"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "UNKNOWN"
    },
    "snowfall_cm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snowfall Cm"
    },
    "source": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "temperature_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature C"
    },
    "valid_at": {
      "format": "date-time",
      "title": "Valid At",
      "type": "string"
    },
    "visibility_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visibility M"
    },
    "weather_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Category"
    },
    "weather_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Code"
    },
    "wind_gust_kmh": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wind Gust Kmh"
    },
    "wind_speed_kmh": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wind Speed Kmh"
    }
  },
  "required": [
    "id",
    "location",
    "valid_at",
    "source"
  ],
  "title": "WeatherForecastPoint",
  "type": "object",
  "x-contract-version": "1.0.0"
}
