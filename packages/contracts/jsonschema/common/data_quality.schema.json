{
  "$defs": {
    "DataConflict": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "values": {
          "items": {},
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field_path",
        "values",
        "source_ids"
      ],
      "title": "DataConflict",
      "type": "object"
    },
    "DataStatus": {
      "enum": [
        "FRESH",
        "STALE",
        "UNAVAILABLE",
        "CONFLICTING",
        "PARTIAL"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "QualityFlag": {
      "enum": [
        "MISSING",
        "STALE",
        "CONFLICTING",
        "INFERRED",
        "INCOMPLETE",
        "OUTSIDE_COVERAGE"
      ],
      "title": "QualityFlag",
      "type": "string"
    }
  },
  "$id": "https://smart-travel-assistant.local/schemas/1.0.0/DataQuality.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completeness": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completeness"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/DataConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "coverage": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "freshness_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Seconds"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "score": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/DataStatus",
      "default": "FRESH"
    },
    "weights_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Weights Version",
      "type": "string"
    }
  },
  "title": "DataQuality",
  "type": "object",
  "x-contract-version": "1.0.0"
}
