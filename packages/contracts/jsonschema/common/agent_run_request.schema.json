{
  "$defs": {
    "Intent": {
      "enum": [
        "PLAN_TRIP",
        "CHECK_SAFETY",
        "ASK_INFORMATION",
        "FOLLOW_UP",
        "EMERGENCY"
      ],
      "title": "Intent",
      "type": "string"
    },
    "LocationRef": {
      "additionalProperties": false,
      "properties": {
        "admin1": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Admin1"
        },
        "confirmed_by_user": {
          "default": false,
          "title": "Confirmed By User",
          "type": "boolean"
        },
        "coordinates": {
          "$ref": "#/$defs/Point"
        },
        "country_code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "place_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Place Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "place_id",
        "display_name",
        "coordinates",
        "country_code",
        "timezone",
        "provider"
      ],
      "title": "LocationRef",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "TravelMode": {
      "enum": [
        "FLIGHT",
        "TRAIN",
        "BUS",
        "CAR",
        "WALK",
        "BICYCLE",
        "MULTIMODAL"
      ],
      "title": "TravelMode",
      "type": "string"
    },
    "TravelPreference": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Accessibility",
          "type": "array"
        },
        "avoid_tolls": {
          "default": false,
          "title": "Avoid Tolls",
          "type": "boolean"
        },
        "max_extra_duration_minutes": {
          "default": 90,
          "maximum": 1440,
          "minimum": 0,
          "title": "Max Extra Duration Minutes",
          "type": "integer"
        },
        "prefer_lower_cost": {
          "default": false,
          "title": "Prefer Lower Cost",
          "type": "boolean"
        },
        "prefer_lower_emissions": {
          "default": false,
          "title": "Prefer Lower Emissions",
          "type": "boolean"
        },
        "prefer_safer_route": {
          "default": true,
          "title": "Prefer Safer Route",
          "type": "boolean"
        }
      },
      "title": "TravelPreference",
      "type": "object"
    },
    "TravelRequest": {
      "additionalProperties": false,
      "properties": {
        "avoid_geometries": {
          "items": {
            "$ref": "#/$defs/Polygon"
          },
          "maxItems": 5,
          "title": "Avoid Geometries",
          "type": "array"
        },
        "conversation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "departure_time": {
          "format": "date-time",
          "title": "Departure Time",
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/LocationRef"
        },
        "intent_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "live_location_consent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Live Location Consent Id"
        },
        "locale": {
          "default": "en-US",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "title": "Locale",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/LocationRef"
        },
        "preferences": {
          "$ref": "#/$defs/TravelPreference"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "return_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Time"
        },
        "supersedes_request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Request Id"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "travel_modes": {
          "items": {
            "$ref": "#/$defs/TravelMode"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Travel Modes",
          "type": "array"
        },
        "trip_id": {
          "format": "uuid",
          "title": "Trip Id",
          "type": "string"
        },
        "trip_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Trip Revision",
          "type": "integer"
        },
        "user_scope_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pseudonymous owner hash; never the subject id",
          "title": "User Scope Hash"
        }
      },
      "required": [
        "request_id",
        "trip_id",
        "origin",
        "destination",
        "departure_time",
        "travel_modes",
        "timezone"
      ],
      "title": "TravelRequest",
      "type": "object"
    }
  },
  "$id": "https://smart-travel-assistant.local/schemas/1.0.0/AgentRunRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget_override": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Override"
    },
    "conversation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "resume_from_request_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume From Request Id"
    },
    "travel_request": {
      "$ref": "#/$defs/TravelRequest"
    }
  },
  "required": [
    "travel_request"
  ],
  "title": "AgentRunRequest",
  "type": "object",
  "x-contract-version": "1.0.0"
}
