    "BBox": {
      "additionalProperties": false,
      "description": "[min_lon, min_lat, max_lon, max_lat]",
      "properties": {
        "max_lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Max Lat",
          "type": "number"
        },
        "max_lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Max Lon",
          "type": "number"
        },
        "min_lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Min Lat",
          "type": "number"
        },
        "min_lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Min Lon",
          "type": "number"
        }
      },
      "required": [
        "min_lon",
        "min_lat",
        "max_lon",
        "max_lat"
      ],
      "title": "BBox",
      "type": "object"
    },
    "DataConflict": {
