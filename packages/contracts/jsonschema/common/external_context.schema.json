            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends At"
        },
        "event_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/DisasterEventType"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Geometry"
        },
        "instruction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude"
        },
        "official": {
          "default": false,
          "title": "Official",
          "type": "boolean"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "UNKNOWN"
        },
        "source": {
          "$ref": "#/$defs/SourceProvenance"
        },
