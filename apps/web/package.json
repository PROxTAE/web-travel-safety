{
  "name": "@sta/web",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Travel Assistant traveler web app (Next.js 16, HeroUI v3, MapLibre)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "gen:openapi": "openapi-typescript ../../packages/contracts/openapi/public-api.yaml -o lib/api/generated/public-api.d.ts",
    "sync:assets": "node scripts/sync-assets.mjs",
    "verify:no-mocks": "node scripts/verify-no-mocks.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sta/ts-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
