# =============================================================================
# Smart Travel Assistant — environment template
# Copy to .env and fill in real values locally. NEVER commit .env.
# Required = service refuses to start without it. Optional = capability degrades
# to UNAVAILABLE honestly when missing.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
APP_ENV=development                      # required: development|test|staging|production
LOG_LEVEL=INFO                           # optional
CONTRACT_VERSION=1.0.0                   # required
SERVICE_AUTH_TOKEN=                      # required: shared bearer token for /internal/v1 calls (generate: openssl rand -hex 32)

# ---- Database / cache / vector store ----------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_travel
POSTGRES_USER=sta                        # required
POSTGRES_PASSWORD=                       # required: generate per machine
# Per-service roles are created by infra/postgres/init/01-roles.sql using the
# passwords below (one role per schema). Leave blank to fail fast.
POSTGRES_API_PASSWORD=
POSTGRES_AGENT_PASSWORD=
POSTGRES_PROVIDER_PASSWORD=
POSTGRES_INTEGRATION_PASSWORD=
POSTGRES_KNOWLEDGE_PASSWORD=
POSTGRES_DECISION_PASSWORD=
POSTGRES_RECOMMENDATION_PASSWORD=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---- Auth (Keycloak OIDC) ---------------------------------------------------
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=                 # required for local keycloak container
OIDC_ISSUER=http://localhost:8080/realms/smart-travel
OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/smart-travel
OIDC_AUDIENCE=smart-travel-api
OIDC_CLIENT_ID=smart-travel-web
OIDC_CLIENT_SECRET=                      # required: set in Keycloak client credentials
AUTH_SECRET=                             # required: Auth.js cookie encryption (openssl rand -base64 32)
AUTH_URL=http://localhost:3000
EMERGENCY_PROFILE_ENCRYPTION_KEY=        # required: 32-byte base64 key for envelope encryption

# ---- Real providers ---------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=                             # optional: road routing + nearby POIs are UNAVAILABLE without it
AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_CLIENT_ID=                       # optional: flight capability UNAVAILABLE without production creds
AMADEUS_CLIENT_SECRET=
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
GTFS_PROVIDER_CONFIG=/app/config/providers.yaml
MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty   # public style with attribution; replace with licensed tiles in production

# ---- LLM (explanation only; action is locked before the call) --------------
OPENAI_API_KEY=                          # optional: deterministic fallback template used when missing
OPENAI_EXPLAINER_MODEL=                  # e.g. gpt-4.1-mini ; required only when OPENAI_API_KEY is set
OPENAI_TIMEOUT_SECONDS=12

# ---- Embeddings / knowledge -------------------------------------------------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
KNOWLEDGE_COLLECTION_PREFIX=sta_knowledge
RISK_MODEL_ARTIFACT_DIR=/app/artifacts

# ---- Internal URLs / budgets -------------------------------------------------
AGENT_SERVICE_URL=http://agent:8001
EXTERNAL_DATA_SERVICE_URL=http://external-data:8002
DATA_INTEGRATION_SERVICE_URL=http://data-integration:8003
RISK_KNOWLEDGE_SERVICE_URL=http://risk-knowledge:8004
DECISION_SERVICE_URL=http://decision-engine:8005
RECOMMENDATION_SERVICE_URL=http://recommendation:8006
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=10
AGENT_TOTAL_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=12
MAX_LLM_CALLS=2

# ---- Web (only NEXT_PUBLIC_ values reach the browser) -----------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
API_INTERNAL_BASE_URL=http://api:8000

# ---- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

# ---- Notifications (local only) ---------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.invalid
